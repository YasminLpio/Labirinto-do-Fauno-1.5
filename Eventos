//classe
   export class Evento {
//campos/atributos

    nome: string = "";
    class: string = "";
    vida: number = 100;
    arma: string = "";

//metodos
    receberDano (dano: number): number {
        if (!Number.isFinite(dano) || dano < 0) {
            throw new Error("O dano deve ser um número não negativo.");
        }
        this.vida = Math.max(0, this.vida - dano);
        return this.vida;
    }
    
    estaVivo() {
        return this.vida > 0;
    }
}
